# ChordsPlay web app (web/app.py): central database, audio files and the page.
# Installed by contrib/install-web.sh as a user unit; a reverse proxy can publish it
# (example: contrib/apache-chordsplay-web.conf). See docs/web.md.
[Unit]
Description=ChordsPlay web app
After=network-online.target

[Service]
Type=simple
# Settings (CHORDSPLAY_MUSIC_DIRS, ...): template contrib/chordsplay.env.example
EnvironmentFile=-%h/.config/chordsplay/web.env
# Optional CHORDSPLAY_MUSIC_MOUNT: a network share that is sometimes not mounted at
# boot (network not up yet). Its fstab entry needs "users" to be mounted without root.
ExecStartPre=-/bin/sh -c '[ -z "$CHORDSPLAY_MUSIC_MOUNT" ] || mountpoint -q "$CHORDSPLAY_MUSIC_MOUNT" || mount "$CHORDSPLAY_MUSIC_MOUNT"'
WorkingDirectory=%h/.local/share/chordsplay-web/app
ExecStart=%h/.local/share/chordsplay-web/venv/bin/python -m web.app
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
