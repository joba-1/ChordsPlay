# Settings of the ChordsPlay web server: a template with every setting and its default.
# Copy it to where the service reads it (contrib/chordsplay-web.service:
# ~/.config/chordsplay/web.env) and change what you need. Lines are NAME=value, without
# quotes. Your copy holds your own paths and names: keep it out of the repo (git ignores
# *.env in a checkout).

# Folders with the songs, ":"-separated. Added to the library at start and scanned
# at start and every CHORDSPLAY_SCAN_HOURS. Required for a new installation.
#CHORDSPLAY_MUSIC_DIRS=/srv/music:/home/me/Music

# A network share to mount before the server starts, if it isn't mounted (optional;
# used by the unit, not by the server).
#CHORDSPLAY_MUSIC_MOUNT=/mnt/music

# The database file (created at the first start).
#CHORDSPLAY_WEB_DB=~/.local/share/chordsplay-web/chordsplay.db

# Address and port the server listens on. Keep 127.0.0.1 behind a reverse proxy: the
# server itself has no login.
#CHORDSPLAY_HOST=127.0.0.1
#CHORDSPLAY_PORT=8616

# Database user for requests that don't come through the proxy (default: $USER).
#CHORDSPLAY_USER=me
# Login name at the reverse proxy -> database user, for names that differ.
#CHORDSPLAY_USER_MAP=jo=joe,flo=florence

# Rescan the library and fetch new chords every N hours (0: never).
#CHORDSPLAY_SCAN_HOURS=24

# More folders with PDF tabs, ":"-separated (tabs next to their songs are always found).
#CHORDSPLAY_PDF_DIRS=~/.local/share/chordsplay-web/pdf

# Where recorded takes are kept.
#CHORDSPLAY_TAKES_DIR=~/.local/share/chordsplay-web/takes

# Suggested amp presets from a local LLM (Ollama); without one nothing is suggested.
#CHORDSPLAY_OLLAMA_URL=http://127.0.0.1:11434
#CHORDSPLAY_SUGGEST_MODEL=qwen3.6:latest
