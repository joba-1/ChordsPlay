# Mustang Micro Plus amp agent for ChordsPlay: maneline's mmp_web.py owns the
# single Bluetooth LE connection to the amp (see docs/spec-amp.md).
# Installed by contrib/install-amp-agent.sh. Deliberately has no [Install]
# section: ChordsPlay starts it while the amp's audio sink exists (amp_unit).
[Unit]
Description=Mustang Micro Plus amp agent for ChordsPlay (maneline mmp_web.py)
After=bluetooth.target

[Service]
Type=simple
# --idle-disconnect: save the amp's battery when idle; stays connected while
#   Bluetooth audio streams to the amp, so switching during a song is instant.
# --log /dev/null: the protocol log records every heartbeat (4/s, ~1 MB/hour).
# Port: set AMP_AGENT_PORT in the optional environment file (written by
#   install-amp-agent.sh when AMP_PORT is given); amp_url must use the same port.
Environment=AMP_AGENT_PORT=8081
EnvironmentFile=-%h/.config/chordsplay/amp-agent.env
ExecStart=%h/.local/share/chordsplay/maneline-venv/bin/python %h/.local/share/chordsplay/maneline/scripts/mmp_web.py --port ${AMP_AGENT_PORT} --idle-disconnect 300 --log /dev/null
Restart=on-failure
RestartSec=5
