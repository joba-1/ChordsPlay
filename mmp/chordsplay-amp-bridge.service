# ChordsPlay amp bridge (mmp/bridge.py): follows the web app and switches the
# Mustang Micro Plus through the amp agent on this computer. See docs/web.md.
# Installed by mmp/install-amp-bridge.sh.
[Unit]
Description=ChordsPlay amp bridge (web app -> amp agent)
After=network-online.target

[Service]
WorkingDirectory=%h/.local/share/chordsplay/bridge
# the agent's port, if its install stored one (AMP_AGENT_PORT)
EnvironmentFile=-%h/.config/chordsplay/amp-agent.env
# CHORDSPLAY_BRIDGE_URL (the line from the page's tone dialog) and optional settings
EnvironmentFile=%h/.config/chordsplay/bridge.env
ExecStart=/usr/bin/env python3 -m mmp.bridge
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
