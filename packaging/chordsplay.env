# Settings of the ChordsPlay web server (chordsplay.service). Lines are NAME=value,
# without quotes. After a change: systemctl restart chordsplay
# Every setting with its default: chordsplay.env.example in the package's documentation.

# Folders with the songs, ":"-separated; the user chordsplay must be able to read them.
# Added to the library at start and scanned at start and once a day. Required.
#CHORDSPLAY_MUSIC_DIRS=/srv/music

# Address and port the server listens on. Keep 127.0.0.1 behind a reverse proxy: the
# server itself has no login.
#CHORDSPLAY_HOST=127.0.0.1
#CHORDSPLAY_PORT=8616

# Database user for requests that don't come through the proxy (default: chordsplay).
#CHORDSPLAY_USER=me
# Login name at the reverse proxy -> database user, for names that differ.
#CHORDSPLAY_USER_MAP=jo=joe,flo=florence

# The database, takes and PDF tabs are in /var/lib/chordsplay (chordsplay.db, takes/,
# pdf/); CHORDSPLAY_WEB_DB, CHORDSPLAY_TAKES_DIR and CHORDSPLAY_PDF_DIRS move them.
