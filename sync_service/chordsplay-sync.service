[Unit]
Description=ChordsPlay central chord sync service
After=network.target

[Service]
Type=simple
# dedicated unprivileged system user (see README: useradd --system chordsync)
User=chordsync
Group=chordsync
WorkingDirectory=/opt/chordsplay-sync
Environment=CHORDSPLAY_CENTRAL_DB=/opt/chordsplay-sync/chordsplay-central.db
Environment=CHORDSPLAY_SYNC_TOKEN=CHANGE-ME
# Bind on all interfaces; the firewall restricts 8615 to LAN + VPN sources
# (see README). Token auth is the second layer. Put behind Apache mod_proxy
# instead (apache-chordsplay.conf, bind 127.0.0.1) if a host already fronts it.
ExecStart=/opt/chordsplay-sync/venv/bin/gunicorn -w 2 -b 0.0.0.0:8615 app:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
